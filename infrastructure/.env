# PostgreSql configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=iot_platform

# Redis configuration
REDIS_PASSWORD=redis_password
REDIS_HOST=redis

# Kafka configuration
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
ALLOW_PLAINTEXT_LISTENER=yes

# Clickhouse configuration
CLICKHOUSE_USER=demo_user
CLICKHOUSE_PASSWORD=demo_pass

# Kafka Schema Registry configuration
SCHEMA_REGISTRY_KAFKASTORE_BOOTSTRAP_SERVERS=PLAINTEXT://kafka:9094
SCHEMA_REGISTRY_HOST_NAME=schema-registry

# Events Collector Service configuration
REDIS_PORT=6379
SCHEMA_REGISTRY_URL=http://schema-registry:8081
KAFKA_BOOTSTRAP_SERVERS=kafka:9094
CLICKHOUSE_HOST=clickhouse
SCHEDULING_OUTBOX_CRON=0 * * * * *

# Kafka UI configuration
KAFKA_CLUSTERS_0_NAME=local
KAFKA_CLUSTERS_0_BOOTSTRAP_SERVERS=kafka:9094
KAFKA_CLUSTERS_0_SCHEMAREGISTRY=http://schema-registry:8081

# Minio Configuration
MINIO_ROOT_USER=minioAdmin
MINIO_ROOT_PASSWORD=minioAdmin

# Keycloak configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_DB=postgres
KC_DB_URL_HOST=postgres
KC_HOSTNAME=localhost
KC_DB_SCHEMA=keycloak

# Alloy DB configuration
ALLOYDB_USER=alloydb
ALLOYDB_PASSWORD=alloydb
ALLOYDB_DB=alloydb

#Grafana configuration
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Loki configuration
GRAFANA_LOKI_URL=http://loki:3100/loki/api/v1/push